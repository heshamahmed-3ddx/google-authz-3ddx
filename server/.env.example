# Server Environment Variables
NODE_ENV=development
PORT=3001

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Super Admin Group (Google Workspace group with full admin access)
SUPER_ADMIN_GROUP=SWD

# MySQL Database Configuration (PowerBI CP Test Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=powerbi_cp_test
DB_CONNECTION_LIMIT=10

# PowerBI Configuration
POWERBI_WORKSPACE_ID=dc128709-2496-4000-9f38-8e154f91fb0d
POWERBI_REPORT_ID=0d2261f5-b24f-4696-91ab-655a833e42f0
POWERBI_TENANT_ID=7153c4ca-59f2-4386-8d08-aa17f2f345ef
POWERBI_CLIENT_ID=69fd2c72-0e78-4524-ba35-23168f80153c
POWERBI_CLIENT_SECRET=your_powerbi_client_secret_here

# Database (Legacy - if needed for other purposes)
# DATABASE_URL=mongodb://localhost:27017/google-authz-3ddx
# DATABASE_URL=postgresql://user:password@localhost:5432/google_authz_3ddx