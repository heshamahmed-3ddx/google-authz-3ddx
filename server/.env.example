# Server Environment Variables
NODE_ENV=development
PORT=3001

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MySQL Database Configuration (PowerBI CP Test Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=powerbi_cp_test
DB_CONNECTION_LIMIT=10

# Database (Legacy - if needed for other purposes)
# DATABASE_URL=mongodb://localhost:27017/google-authz-3ddx
# DATABASE_URL=postgresql://user:password@localhost:5432/google_authz_3ddx