{
  "name": "google-authz-3ddx-client",
  "version": "1.0.0",
  "description": "Vue 3 + Vuetify frontend for Google Authorization demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .eslintignore",
    "format": "prettier --write src/",
    "docs:generate": "jsdoc src/**/*.js -d docs/jsdoc -c jsdoc.config.json",
    "docs:serve": "npx http-server docs/jsdoc -p 8080 -o"
  },
  "dependencies": {
    "@mdi/font": "^7.2.96",
    "axios": "^1.5.0",
    "pinia": "^2.1.6",
    "puppeteer": "^24.24.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vue": "^3.3.4",
    "vue-i18n": "^9.3.0",
    "vue-router": "^4.2.4",
    "vuetify": "^3.3.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.47.0",
    "eslint-plugin-vue": "^9.17.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.2",
    "jsdom": "^22.1.0",
    "prettier": "^3.0.2",
    "sass": "^1.66.1",
    "vite": "^5.4.20",
    "vitest": "^0.34.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "vite.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
