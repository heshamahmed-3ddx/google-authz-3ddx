{
  "source": {
    "include": [
      "../client/src",
      "../server/src"
    ],
    "includePattern": "\\.js$",
    "exclude": [
      "node_modules/",
      "dist/",
      "build/",
      "coverage/",
      "test-results/",
      "**/*.vue"
    ]
  },
  "opts": {
    "destination": "./docs/jsdoc/",
    "recurse": true,
    "readme": "./docs/README-JSDOC.md"
  },
  "plugins": [
    "plugins/markdown"
  ],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "metadata": {
    "title": "InsightHub - Full Stack Documentation",
    "description": "Complete JavaScript documentation for InsightHub frontend (Vue.js) and backend (Node.js/Express)"
  }
}