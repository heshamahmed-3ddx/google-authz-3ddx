{
  "source": {
  "include": ["client/src/services", "client/src/stores", "client/src/components", "client/src/views"],
    "includePattern": "\\.(js|vue)$",
    "exclude": ["node_modules/"]
  },
  "opts": {
    "destination": "./docs/jsdoc/",
    "recurse": true
  },
  "plugins": [
    "plugins/markdown"
  ],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "metadata": {
  "title": "InsightHub - Client Documentation",
  "description": "JavaScript documentation for the InsightHub Vue.js client application"
  }
}